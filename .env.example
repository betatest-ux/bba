# ──────────────────────────────────────────────────────────────────────────
# BBAlliance — environment variables
# Copy to .env and fill in. See README.md for full explanations.
# ──────────────────────────────────────────────────────────────────────────

# Database. SQLite file for local development (default), or a Postgres URL in
# production — the adapter switches automatically based on the scheme.
DATABASE_URI=file:./bba.db
# DATABASE_URI=postgres://user:password@host:5432/bballiance

# Secret used to encrypt sessions/JWTs. Long and random. REQUIRED.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public URL of the site, no trailing slash. Used for CORS, links, sitemaps.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret that authorises the scheduled-publish cron endpoint (Vercel Cron etc).
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Secret used to validate live-preview/draft requests.
PREVIEW_SECRET=YOUR_SECRET_HERE

# ── Email (pick ONE route; if neither is set, emails print to the console) ──
# Route A: Resend
# RESEND_API_KEY=re_xxxxxxxxx
# Route B: any SMTP provider
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=postmaster@example.com
# SMTP_PASS=xxxxxxxx

# From-address for transactional email (must be allowed by your provider).
EMAIL_FROM=noreply@bballiance.org.uk
EMAIL_FROM_NAME=BBAlliance

# Password given to the demo users created by `pnpm seed` (change it!).
SEED_ADMIN_PASSWORD=bballiance-demo

# Docker (VPS route) only: password for the bundled Postgres.
# POSTGRES_PASSWORD=change-me
